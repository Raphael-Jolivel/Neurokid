# ------------------------------------------------------------
# VM Back - variables d'environnement
# ------------------------------------------------------------
# Copier ce fichier en `.env` puis remplir les valeurs réelles.
# Le fichier `.env` ne doit JAMAIS être commit (cf. .gitignore).
# ------------------------------------------------------------

# --- Connexion à la VM Base de données ----------------------
# Mettre l'IP (ou le hostname VPN) de la VM DB.
DB_HOST=10.18.60.25
DB_PORT=3306
DB_USER=neurokid
DB_PASSWORD=change-me-strong-password
DB_NAME=cognitive_assessment

# --- Sécurité applicative -----------------------------------
# Liste blanche des origines autorisées par CORS (séparées par
# des virgules). Mettre l'URL de la VM Front.
CORS_ORIGINS=http://10.18.60.24

# --- Réseau -------------------------------------------------
# Port HTTP exposé par le proxy nginx local.
HTTP_PORT=80
