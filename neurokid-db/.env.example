# ------------------------------------------------------------
# VM Base de données - variables d'environnement
# ------------------------------------------------------------
# Copier ce fichier en `.env` puis remplir les vraies valeurs.
# Le fichier `.env` ne doit JAMAIS être commit (cf. .gitignore).
# ------------------------------------------------------------

# --- MariaDB ------------------------------------------------
MARIADB_ROOT_PASSWORD=change-me-root-password
MARIADB_DATABASE=cognitive_assessment
MARIADB_USER=neurokid
MARIADB_PASSWORD=change-me-strong-password

# --- Réseau -------------------------------------------------
# Adresse IP locale sur laquelle on bind 3306. Mettre l'IP VPN
# de cette VM pour ne PAS exposer la BDD ailleurs. 0.0.0.0
# convient si la VM n'a que l'interface VPN.
DB_BIND_HOST=0.0.0.0
DB_PORT=3306

# Port d'accès phpMyAdmin (sur l'hôte).
PHPMYADMIN_PORT=8080
