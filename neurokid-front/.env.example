# ------------------------------------------------------------
# VM Front - variables d'environnement
# ------------------------------------------------------------
# Copier ce fichier en `.env` puis remplir les valeurs réelles.
# Le fichier `.env` ne doit JAMAIS être commit (cf. .gitignore).
# ------------------------------------------------------------

# URL publique de la VM Back, telle qu'elle sera appelée par le
# navigateur depuis le VPN. Le `/api` est obligatoire car c'est
# le préfixe géré par le proxy nginx de la VM Back.
API_URL=http://10.18.60.23/api

# Port HTTP exposé par nginx sur cette VM.
HTTP_PORT=80
